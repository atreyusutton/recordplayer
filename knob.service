[Unit]
Description=Record Player Physical Volume Knob
After=sound.target

[Service]
User=admin
Environment=HOME=/home/admin
WorkingDirectory=/home/admin/apps/recordplayer
ExecStart=/usr/bin/python3 /home/admin/apps/recordplayer/knob.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
