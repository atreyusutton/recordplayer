[Unit]
Description=Record Player Spotify Control UI
After=network.target

[Service]
User=admin
Environment=HOME=/home/admin
WorkingDirectory=/home/admin/apps/recordplayer
ExecStart=/usr/bin/python3 /home/admin/apps/recordplayer/control.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
