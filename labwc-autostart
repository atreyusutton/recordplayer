#!/usr/bin/env bash
# labwc autostart — runs after labwc is fully initialized (window rules ready)
# Deployed to ~/.config/labwc/autostart

CHROMIUM=$(command -v chromium-browser 2>/dev/null || command -v chromium 2>/dev/null)

# HDMI-A-1 (round album art) at origin, DSI-1 (touch UI) to the right.
# pygame fullscreen lands on primary output (HDMI-A-1); Chromium is placed on
# DSI-1 by the windowRule in rc.xml.
wlr-randr --output HDMI-A-1 --pos 0,0 --output DSI-1 --pos 720,120

# Let labwc fully settle its DRM outputs before adding more client load.
# Launching Chromium during labwc's output enumeration causes DRM contention
# that retriggers the ~40s stall on this Pi's dual-display config.
# 3 seconds is enough — Flask is usually ready by then anyway.
sleep 3
for i in $(seq 1 10); do
    curl -s http://localhost:8080 >/dev/null 2>&1 && break
    sleep 1
done

(while true; do
    "$CHROMIUM" \
        --kiosk \
        --ozone-platform=wayland \
        --user-data-dir=/tmp/chromium-kiosk \
        --noerrdialogs \
        --disable-infobars \
        --no-first-run \
        --disable-session-crashed-bubble \
        --disable-component-update \
        --check-for-update-interval=31536000 \
        --disable-features=TranslateUI,CalculateNativeWinOcclusion,Translate \
        --disable-background-networking \
        --disable-background-timer-throttling \
        --disable-renderer-backgrounding \
        --disable-sync \
        --disable-breakpad \
        --disable-crash-reporter \
        --no-pings \
        --overscroll-history-navigation=0 \
        --password-store=basic \
        http://localhost:8080
    sleep 2
done) &
