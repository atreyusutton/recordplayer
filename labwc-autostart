#!/usr/bin/env bash
# labwc autostart — runs after labwc is fully initialized (window rules ready)
# Deployed to ~/.config/labwc/autostart

CHROMIUM=$(command -v chromium-browser 2>/dev/null || command -v chromium 2>/dev/null)

# Wait for Flask backend (up to 60 s)
for i in $(seq 1 60); do
    curl -s http://localhost:8080 >/dev/null 2>&1 && break
    sleep 1
done

# Launch Chromium in a restart loop (runs in background so labwc init isn't blocked)
# --user-data-dir isolates this instance so it never piggybacks on another session.
(while true; do
    "$CHROMIUM" \
        --kiosk \
        --ozone-platform=wayland \
        --user-data-dir=/tmp/chromium-kiosk \
        --noerrdialogs \
        --disable-infobars \
        --no-first-run \
        --disable-session-crashed-bubble \
        --disable-component-update \
        --check-for-update-interval=31536000 \
        --disable-features=TranslateUI \
        --overscroll-history-navigation=0 \
        --password-store=basic \
        http://localhost:8080
    sleep 5
done) &
