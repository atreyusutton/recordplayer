[Unit]
Description=Record Player Album Art Display
After=labwc.service
Requires=labwc.service

[Service]
User=admin
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=SDL_VIDEODRIVER=wayland
Environment=HOME=/home/admin
WorkingDirectory=/tmp
ExecStartPre=/bin/sh -c 'until [ -S /run/user/1000/wayland-0 ]; do sleep 0.1; done'
ExecStart=/usr/bin/python3 /home/admin/apps/recordplayer/display.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
