[Unit]
Description=Record Player Album Art Display
After=graphical.target labwc.service
Wants=labwc.service

[Service]
User=admin
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=SDL_VIDEODRIVER=wayland
Environment=HOME=/home/admin
WorkingDirectory=/tmp
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/python3 /home/admin/apps/recordplayer/display.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
