<?xml version="1.0"?>
<!-- labwc input + window rules — deployed to ~/.config/labwc/rc.xml -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <!-- Touch input mapping.
       No deviceName = applies to all touch devices. This is intentional:
       the ft5x06 kernel driver appends a firmware-ID suffix to the device
       name (e.g. "10-0038 generic ft5x06 (79)") that can change across
       firmware revisions, silently breaking exact-match rules. Since this
       appliance has exactly one touchscreen, unconditional mapping is
       more robust than pinning a specific name. -->
  <touch mapToOutput="DSI-1" mouseEmulation="yes"/>

  <!-- Window rules: Chromium → DSI touchscreen, pygame album art → round HDMI.
       Chromium's wayland app_id is "chromium-browser" on Debian Trixie;
       match multiple variants to be safe. -->
  <windowRules>
    <windowRule identifier="chromium-browser">
      <action name="MoveToOutput" output="DSI-1"/>
    </windowRule>
    <windowRule identifier="Chromium-browser">
      <action name="MoveToOutput" output="DSI-1"/>
    </windowRule>
    <windowRule identifier="chromium">
      <action name="MoveToOutput" output="DSI-1"/>
    </windowRule>
    <windowRule title="Record Player">
      <action name="MoveToOutput" output="HDMI-A-1"/>
    </windowRule>
  </windowRules>
</openbox_config>
